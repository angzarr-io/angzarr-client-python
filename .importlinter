# Architecture contracts for angzarr_client, checked by import-linter
# (`just archlint`; pre-commit and CI run it). Contracts on third-party
# imports live in .importlinter-external.
#
# Shape of the package:
#   router/           the router: native dispatch to business code.
#                     Bottom layer; transport-free.
#   diagnostic        a code and its args shown as text and rendered in
#                     English from the catalogs (decisions 14.37, 14.60):
#                     a leaf, importing nothing of the package, which the
#                     router and the clients' errors both use.
#   child             run_child: a host as the child process of an in-app
#                     runtime (handshake on stdout, Unix socket).
#   descriptor        describe: a component's ComponentDescriptor, built
#                     from its dispatch table (raises the host's errors).
#   host              ComponentHost: serves registered components over gRPC,
#                     on top of the router, readiness and server config.
#   client, builder,  coordinator clients (gRPC stubs + fluent builders) and
#   retry, ...        the shared helpers/errors they use.
#   validation        require_* precondition helpers for handlers: they
#                     raise the router's Rejection, so they sit over the
#                     router, not with the coordinator clients.
#   testing/          scenario kit for consumers' tests; no runtime module
#                     depends on it.
#   proto/            generated framework types (any layer may use them).
# Codegen templates (codegen/) and build tooling (scripts/, grpcio-tools) are
# outside the runtime: nothing in the package imports them. The tests package
# (including the generated tier fixture messages, tests/router/gen) is the only
# business-shaped code here, and the package never imports it.

[importlinter]
root_packages =
    angzarr_client
    tests

[importlinter:contract:layers]
name = Host over clients and readiness, router binding at the bottom
type = layers
layers =
    angzarr_client.child | angzarr_client.descriptor
    angzarr_client.host
    angzarr_client.readiness | angzarr_client.server
    angzarr_client.builder : angzarr_client.client
    angzarr_client.router

[importlinter:contract:router-bottom]
name = Router binding depends only on the generated protos and diagnostic
type = forbidden
source_modules =
    angzarr_client.router
forbidden_modules =
    angzarr_client._args
    angzarr_client._pb
    angzarr_client.builder
    angzarr_client.client
    angzarr_client.error_codes
    angzarr_client.errors
    angzarr_client.helpers
    angzarr_client.host
    angzarr_client.identity
    angzarr_client.readiness
    angzarr_client.retry
    angzarr_client.server
    angzarr_client.testing
    angzarr_client.validation
    angzarr_client.wrappers

[importlinter:contract:diagnostic-leaf]
name = diagnostic imports nothing of the package
type = forbidden
source_modules =
    angzarr_client.diagnostic
forbidden_modules =
    angzarr_client._args
    angzarr_client._pb
    angzarr_client.builder
    angzarr_client.child
    angzarr_client.client
    angzarr_client.descriptor
    angzarr_client.error_codes
    angzarr_client.errors
    angzarr_client.helpers
    angzarr_client.host
    angzarr_client.identity
    angzarr_client.proto
    angzarr_client.readiness
    angzarr_client.retry
    angzarr_client.router
    angzarr_client.server
    angzarr_client.testing
    angzarr_client.validation
    angzarr_client.wrappers

[importlinter:contract:clients-unhosted]
name = Coordinator clients do not depend on hosting
type = forbidden
source_modules =
    angzarr_client._args
    angzarr_client._pb
    angzarr_client.builder
    angzarr_client.client
    angzarr_client.error_codes
    angzarr_client.errors
    angzarr_client.helpers
    angzarr_client.identity
    angzarr_client.retry
    angzarr_client.wrappers
forbidden_modules =
    angzarr_client.host
    angzarr_client.readiness
    angzarr_client.router
    angzarr_client.server

[importlinter:contract:testing-kit-unused-at-runtime]
name = Runtime modules never import the testing kit
type = forbidden
source_modules =
    angzarr_client._args
    angzarr_client._pb
    angzarr_client.builder
    angzarr_client.client
    angzarr_client.error_codes
    angzarr_client.errors
    angzarr_client.helpers
    angzarr_client.host
    angzarr_client.identity
    angzarr_client.proto
    angzarr_client.readiness
    angzarr_client.retry
    angzarr_client.router
    angzarr_client.server
    angzarr_client.validation
    angzarr_client.wrappers
forbidden_modules =
    angzarr_client.testing

[importlinter:contract:package-root-no-testing-kit]
name = Package root does not re-export the testing kit
type = forbidden
as_packages = False
source_modules =
    angzarr_client
forbidden_modules =
    angzarr_client.testing
    angzarr_client.testing.**

[importlinter:contract:runtime-free-of-tests]
name = Package never imports the tests package or its rendered fixture code
type = forbidden
source_modules =
    angzarr_client
forbidden_modules =
    tests
