# Generated proto code (regenerated by `just generate-proto` — see
# project_proto_generation_model.md). Never commit.
angzarr_client/proto/**/*_pb2.py
angzarr_client/proto/**/*_pb2_grpc.py
angzarr_client/proto/**/*_pb2.pyi
angzarr_client/proto/**/*_pb2_grpc.pyi
angzarr_client/proto/**/google/
angzarr_client/proto/**/health/
# Generated bindings for the sererr proto (sererr/v1/...). buf places
# output at the root relative to buf.gen.yaml; we mount sererr's source
# at vendor/sererr/proto, so generated Python lands at root sererr/.
sererr/**/*_pb2.py
sererr/**/*_pb2_grpc.py
sererr/**/*_pb2.pyi
sererr/**/*_pb2_grpc.pyi
# buf occasionally drops top-level google/ next to the buf.gen.yaml before
# scripts/generate_protos.py relocates it; gitignore the transient too.
/google/
/health/

# mutation testing reports (disposable)
mutants-reports/
